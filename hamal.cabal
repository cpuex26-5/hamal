cabal-version: 3.14
name: hamal
version: 0.1.0.0
license: BSD-3-Clause
license-file: LICENSE
author: atree4728
maintainer: atree.public@gmail.com
category: Language
build-type: Simple
extra-doc-files: README.md

common defaults
  ghc-options:
    -Wall
    -Wcompat
    -Wdefaulted-exception-context
    -Widentities
    -Winvalid-haddock
    -Wmissing-export-lists
    -Wmissing-deriving-strategies
    -Woperator-whitespace
    -Wpartial-fields
    -Wredundant-constraints
    -Wredundant-bang-patterns
    -Wredundant-strictness-flags
    -Wterm-variable-capture
    -Wunused-packages
    -fhide-source-paths

  default-extensions:
    BlockArguments
    DuplicateRecordFields
    MultiWayIf
    NoFieldSelectors
    OrPatterns
    OverloadedRecordDot
    OverloadedStrings
    RecordWildCards
    StrictData
    ViewPatterns

  default-language: GHC2024
  build-depends: base

library
  import: defaults
  -- cabal-gild: discover src
  exposed-modules:
    Backend.Riscv.Asm
    Backend.Riscv.Virtual
    Frontend.Lexer
    Frontend.Parser
    Frontend.SrcSpan
    Frontend.Syntax
    Frontend.Token
    Id
    Middleend.Closure
    Middleend.KNormal
    Middleend.Opt.Alpha
    Middleend.Opt.Assoc
    Middleend.Opt.Beta

  build-tool-depends:
    alex:alex,
    happy:happy,

  build-depends:
    array,
    bytestring,
    containers,
    transformers,

  hs-source-dirs: src

executable hamal
  import: defaults
  main-is: Main.hs
  build-depends:
    bytestring,
    hamal,
    pretty-simple,

  hs-source-dirs: app

test-suite hamal-test
  import: defaults
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends: hamal
